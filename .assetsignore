# Paths here are NOT uploaded as Worker static assets.
# IMPORTANT: providing this file DISABLES Wrangler's built-in default ignores,
# so .git must be listed explicitly. Otherwise `wrangler deploy` fails with
# "Asset too large" once .git/objects/pack/*.pack grows past 25 MiB.
.git
.github
.gitattributes
.assetsignore
_worker.js
wrangler.toml
*.md
*.log
node_modules

# Stray archives and internal marketing assets - never served publicly.
# blog.rar was live at pdfsign.in/blog.rar (200, 261KB) until 2026-09-23.
blog.rar
*.rar
*.zip
*.7z
marketing

# Wrangler build scratch. The deploy uploads this directory as ordinary assets, which served
# _worker.js.map publicly — the Worker source, despite _worker.js itself being excluded.
.wrangler
